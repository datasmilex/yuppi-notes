{
  "name": "yuppi-notes",
  "version": "1.0.0",
  "description": "YuPPi Notes - Cıvıl cıvıl, gerçek zamanlı post-it not uygulaması (Web, Mobil PWA, Windows EXE)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "electron:dev": "concurrently -k \"node server.js\" \"wait-on tcp:3000 && electron .\"",
    "electron:pack": "electron-builder --win --dir",
    "electron:build": "next build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.yuppi.notes",
    "productName": "YuPPi Notes",
    "directories": {
      "output": "build-exe"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "server.js",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "keywords": [
    "notes",
    "nextjs",
    "electron",
    "pwa",
    "realtime",
    "collaboration"
  ],
  "author": "YuPPi Team",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "14.2.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.19.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5"
  }
}
